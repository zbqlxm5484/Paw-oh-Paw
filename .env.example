# 복사해서 .env 로 만들고 실제 값을 넣는다. .env 는 커밋하지 않는다.

# PostgreSQL 컨테이너 초기화
POSTGRES_DB=creamoff
POSTGRES_USER=creamoff
POSTGRES_PASSWORD=change-me

# Spring 데이터소스 (컨테이너 안에서는 호스트명이 postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/creamoff
SPRING_DATASOURCE_USERNAME=creamoff
SPRING_DATASOURCE_PASSWORD=change-me
