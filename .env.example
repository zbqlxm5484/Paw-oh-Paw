# 복사해서 .env 로 만들고 실제 값을 넣는다. .env 는 커밋하지 않는다.

# PostgreSQL 컨테이너 초기화
POSTGRES_DB=creamoff
POSTGRES_USER=creamoff
POSTGRES_PASSWORD=change-me

# FastAPI 데이터베이스. 드라이버는 pg8000만 허용(backend/app/core/config.py). 컨테이너 안에서는 호스트명이 postgres, 로컬 .venv 실행은 localhost
DATABASE_URL=postgresql+pg8000://creamoff:change-me@postgres:5432/creamoff

# 인증 비밀값. 32자 이상이고 서로 달라야 한다(backend/app/core/config.py).
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 배포에서는 GitLab CI/CD Variable 값을 쓴다. 실제 값은 저장소에 두지 않는다
JWT_SECRET=
FILE_URL_SECRET=

# Redis. 컨테이너 안에서는 호스트명이 redis, 로컬 .venv 실행은 localhost. 호스트 포트는 열지 않는다(compose 내부 네트워크 전용)
REDIS_URL=redis://redis:6379/0

# 분석 API 연결(backend/app/clients/analysis.py). mock이면 백엔드가 견본 결과를 돌려주고 BASE_URL·KEY는 쓰지 않는다
# 배포(http): 분석 API는 SSAFY GPU 서버에서 돌고, GPU 서버가 연 SSH 역방향 터널로 EC2 호스트 172.18.0.1:18010에 닿는다.
#   컨테이너는 compose의 extra_hosts(host.docker.internal:172.18.0.1)로 그 주소를 이름으로 부른다
# ANALYSIS_API_KEY는 GPU 서버 ~/service/env의 ANALYSIS_API_KEY와 같은 값이다. 배포에서는 GitLab CI/CD Variable(ENV_FILE)을 쓴다. 실제 값은 저장소에 두지 않는다
ANALYSIS_API_MODE=mock
ANALYSIS_API_BASE_URL=http://host.docker.internal:18010
ANALYSIS_API_KEY=

# 영상 업로드 한도(MB). 아래 세 값을 같게 맞춘다: 이 UPLOAD_MAX_MB, GPU 서버 ANALYSIS_UPLOAD_MAX_MB, nginx client_max_body_size(infra/docker/nginx.conf, 100m).
# 분석 API 한도가 더 작으면 백엔드는 받았는데 분석 제출이 재시도 없이 ANALYSIS_SUBMIT_FAILED로 실패한다
UPLOAD_MAX_MB=100
