# 명세 16절 환경 변수. 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.
# 비밀값 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- DB (필수) ---
DATABASE_URL=postgresql+pg8000://creamoff:creamoff@localhost:5432/creamoff
# 테스트용 DB. 운영 DB와 달라야 한다. pytest가 이 DB의 테이블을 지웠다가 다시 만든다.
TEST_DATABASE_URL=postgresql+pg8000://creamoff:creamoff@localhost:5432/creamoff_test

# --- 인증 (API 서버를 켤 때 필수, 32자 이상, 서로 달라야 한다) ---
JWT_SECRET=
JWT_EXPIRE_HOURS=12
FILE_URL_SECRET=
FILE_URL_TTL_SEC=300
# 담당자 스냅샷을 프로세스 메모리에 두는 시간(초). 0이면 요청마다 DB를 읽는다(11.6)
AUTH_CACHE_TTL_SEC=60

# --- 화면 ---
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Seoul

# --- 메일 (비밀번호 재설정 링크, 11.6) ---
# SMTP_HOST가 비어 있으면 메일을 보내지 않는다(재설정 요청은 503). STARTTLS. 계정은 허정원에게 받는다
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 재설정 링크의 앞부분: {FRONTEND_BASE_URL}/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:5173

# --- 파일 저장소 ---
STORAGE_BACKEND=local
STORAGE_ROOT=./data/files
UPLOAD_TMP_DIR=./data/tmp
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PREFIX=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- 업로드 검사 ---
UPLOAD_MAX_MB=100
VIDEO_MIN_SEC=1
VIDEO_MAX_SEC=30
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# --- 분석 API ---
ANALYSIS_API_MODE=mock
ANALYSIS_API_BASE_URL=
ANALYSIS_API_KEY=
ANALYSIS_HTTP_TIMEOUT_SEC=30
ANALYSIS_TIMEOUT_SEC=600
ANALYSIS_SUBMIT_MAX_ATTEMPTS=3
MOCK_ANALYSIS_DELAY_SEC=5

# --- 워커 ---
WORKER_POLL_INTERVAL_SEC=2
WORKER_MAX_IN_FLIGHT=16
WORKER_MAX_IN_FLIGHT_PER_INSTITUTION=4
WORKER_RENDER_CONCURRENCY=1
# 보고서를 동시에 만드는 프로세스 수. 2면 한 회차의 두 판본을 함께 만든다. 서버 코어가 모자라면 1
WORKER_REPORT_CONCURRENCY=2
# 휴지통 비우기·계약 종료 뒤 파기 한 차례가 워커의 주 반복을 붙잡는 시간의 상한(초). 넘으면 남은 것은 5분 뒤에 잇는다
WORKER_SWEEP_MAX_SEC=60

# --- 그 밖 ---
RECOMMENDED_PASSES=8
SIZE_SMALL_MAX_KG=10
SIZE_MEDIUM_MAX_KG=25
BREEDS_FILE=config/breeds.yaml
TOLERANCE_FILE=config/tolerance.yaml
# 보고서 PDF를 웹의 인쇄 화면으로 만들 때만 채운다(둘 다). 비우면 기본 템플릿(WeasyPrint)으로 만든다
# 배포(compose.yaml)는 worker 에 이 두 값을 직접 넣으므로 .env 에는 적지 않아도 된다. 로컬은 Gotenberg 를 띄울 때만 채운다
# REPORT_RENDERER_URL=http://gotenberg:3000
# REPORT_PRINT_URL=http://nginx/web
# REPORT_RENDER_TIMEOUT_SEC=60
MESSAGES_FILE=messages/ko.yaml
LOG_LEVEL=INFO
# 루트 /metrics(요청 수·처리 시간, Prometheus 형식)를 여는지. 인증이 없어 내부망의 Prometheus만 읽게 한다(15.9)
METRICS_ENABLED=false
# /docs·/redoc·/openapi.json 시험 화면. 개발 환경에서만 true, 배포에서는 false(공식 명세는 docs/openapi.yaml)
API_DOCS_ENABLED=true
