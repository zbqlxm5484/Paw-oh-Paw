    "android:apk": "npm run build:android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tanstack/react-query": "^5.104.5",
